<section class="custom-grid">
  <h2 class="grid-title">Tisso vision in the wild</h2>

  <div class="grid-wrapper">
    {% for i in (1..6) %}
      {% assign key = "product_" | append: i %}
      {% assign prod = section.settings[key] %}

      <div class="grid-item">
         {% if prod != blank %}
    
      <img src="{{ prod.featured_image | image_url: width: 800 }}" alt="{{ prod.title }}">
    
    <span class="plus-icon" data-handle="{{ prod.handle }}">+</span>
  {% else %}
    <div class="placeholder">Select product {{ i }}</div>
  {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<!-- Modal Popup -->
<div id="product-modal" class="modal" style="display:none;">
  <div class="modal-content">
    <button class="modal-close">×</button>
    <img class="modal-image" src="" alt="Product Image">
    <h3 class="modal-title"></h3>
    <p class="modal-price"></p>
    <p class="modal-description"></p>

    <form id="variantForm"></form>
    <button id="addToCartBtn" class="cta-btn">ADD TO CART</button>
  </div>
</div>

{% schema %}
{
  "name": "Product Grid (6 Items)",
  "settings": [
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" },
    { "type": "product", "id": "product_5", "label": "Product 5" },
    { "type": "product", "id": "product_6", "label": "Product 6" }
  ],
  "presets": [
    { "name": "Product Grid (6 Items)" }
  ]
}
{% endschema %}

<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal        = document.getElementById('product-modal');
  const closeModal   = document.querySelector('.modal-close');
  const modalTitle   = document.querySelector('.modal-title');
  const modalPrice   = document.querySelector('.modal-price');
  const modalDesc    = document.querySelector('.modal-description');
  const modalImg     = document.querySelector('.modal-image');
  const variantForm  = document.getElementById('variantForm');
  const addToCartBtn = document.getElementById('addToCartBtn');

  // Open modal when + icon clicked
  document.querySelectorAll('.plus-icon').forEach(icon => {
    icon.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();

      const handle = this.getAttribute('data-handle');

      try {
        const res  = await fetch(`/products/${handle}.js`);
        const data = await res.json();

        // Fill modal content
        modalTitle.textContent = data.title;
        modalPrice.textContent = Shopify.formatMoney(data.price);
        modalDesc.textContent  = data.description;
        modalImg.src           = data.images[0];

        // Build variant radio buttons
        variantForm.innerHTML = '';
        data.variants.forEach((v, index) => {
          const radio = document.createElement('input');
          radio.type  = 'radio';
          radio.name  = 'variant_id';
          radio.value = v.id;
          radio.id    = 'var' + v.id;

          // Auto-select first variant
          if(index === 0) radio.checked = true;

          const label = document.createElement('label');
          label.htmlFor = 'var' + v.id;
          label.textContent = v.title;

          variantForm.appendChild(radio);
          variantForm.appendChild(label);
        });

        // Show modal
        modal.style.display = 'block';
      } catch(err) {
        console.error("Failed to load product:", err);
      }
    });
  });

  // Close modal
  closeModal.addEventListener('click', () => modal.style.display = 'none');

  // Close modal when clicking outside
  window.addEventListener('click', (e) => {
    if(e.target === modal) modal.style.display = 'none';
  });

  // Add to cart
  addToCartBtn.addEventListener('click', async function(e){
    e.preventDefault();
    const formData = new FormData(variantForm);
    const variantId = formData.get('variant_id');

    if(!variantId) return alert("Please select a variant!");

    try {
      await fetch('/cart/add.js',{
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ quantity:1, id:variantId })
      });

      // Optional: auto-add conditional product (replace ID with actual)
      // if(selectedVariantTitle.includes('Black') && selectedVariantTitle.includes('Medium')){
      //   await fetch('/cart/add.js',{
      //     method:'POST',
      //     headers:{ 'Content-Type':'application/json' },
      //     body: JSON.stringify({ quantity:1, id:'SOFT_WINTER_JACKET_VARIANT_ID' })
      //   });
      // }

      modal.style.display = 'none';
      alert("Product added to cart!");
    } catch(err) {
      console.error("Add to cart failed:", err);
    }
  });
});
</script>
