<section class="custom-grid">
  <h2 class="grid-title">Tisso vision in the wild</h2>

  <div class="grid-wrapper">
    {% for i in (1..6) %}
      {% assign key = "product_" | append: i %}
      {% assign prod = section.settings[key] %}

     <div class="grid-item">
  {% if prod != blank %}
    <div class="product-wrapper">
      <img src="{{ prod.featured_image | image_url: width: 800 }}" alt="{{ prod.title }}">
      <span class="plus-icon" data-handle="{{ prod.handle }}">+</span>
    </div>
  {% else %}
    <div class="placeholder">Select product {{ i }}</div>
  {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<!-- Modal Popup -->
<div id="product-modal" class="modal" style="display:none;">
  <div class="modal-content">
    <button class="modal-close">×</button>
    <img class="modal-image" src="" alt="Product Image">
    <h3 class="modal-title"></h3>
    <p class="modal-price"></p>
    <p class="modal-description"></p>

  <form id="variantForm">
  <!-- Color options container -->
  <div class="color-options"></div>

  <!-- Size dropdown -->
  <select class="size-select">
    <option value="">Select Size</option>
  </select>
</form>

    <button id="addToCartBtn" class="cta-btn">ADD TO CART</button>
  </div>
</div>

{% schema %}
{
  "name": "Product Grid (6 Items)",
  "settings": [
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" },
    { "type": "product", "id": "product_5", "label": "Product 5" },
    { "type": "product", "id": "product_6", "label": "Product 6" }
  ],
  "presets": [
    { "name": "Product Grid (6 Items)" }
  ]
}
{% endschema %}

<script>
function formatMoney(cents) {
  return '$' + (cents / 100).toFixed(2);
}

document.addEventListener('DOMContentLoaded', function () {
  const modal = document.getElementById('product-modal');
  const variantForm = document.getElementById('variantForm');

  // Add click listener to all + icons AFTER DOM loads
  document.querySelectorAll('.plus-icon').forEach(icon => {
    icon.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();

      const handle = this.dataset.handle;
      console.log('Plus icon clicked!', handle); // <-- debug log
      if(!handle) return console.error("No handle found");

      try {
        const res = await fetch(`/products/${handle}.js`);
        const data = await res.json();
        console.log('Product data loaded:', data); // <-- debug log

        modal.querySelector('.modal-title').textContent = data.title;
        modal.querySelector('.modal-price').textContent = formatMoney(data.price);
        modal.querySelector('.modal-description').innerHTML = data.description;
        modal.querySelector('.modal-image').src = data.images[0];

        // Build variants
        // Clear form
variantForm.querySelector('.color-options').innerHTML = '';
const sizeSelect = variantForm.querySelector('.size-select');
sizeSelect.innerHTML = '<option value="">Select Size</option>';

// Extract unique colors and sizes from variants
const colors = [...new Set(data.variants.map(v => v.option1))]; // assuming first option = color
const sizes = [...new Set(data.variants.map(v => v.option2))]; // assuming second option = size

// Add color boxes
colors.forEach(color => {
  const div = document.createElement('div');
  div.className = 'color-box';
  div.style.background = color.toLowerCase();
  div.dataset.color = color;
  div.addEventListener('click', () => {
    // mark selected
    variantForm.querySelectorAll('.color-box').forEach(c => c.classList.remove('selected'));
    div.classList.add('selected');

    // auto-select first matching variant for this color
    const match = data.variants.find(v => v.option1 === color);
    if(match) {
      sizeSelect.value = match.option2;
      variantForm.dataset.selectedVariant = match.id;
    }
  });
  variantForm.querySelector('.color-options').appendChild(div);
});

// Add size options
sizes.forEach(size => {
  const option = document.createElement('option');
  option.value = size;
  option.textContent = size;
  sizeSelect.appendChild(option);
});

// On size change, update selected variant
sizeSelect.addEventListener('change', () => {
  const selectedColor = variantForm.querySelector('.color-box.selected')?.dataset.color;
  const match = data.variants.find(v => v.option1 === selectedColor && v.option2 === sizeSelect.value);
  if(match) variantForm.dataset.selectedVariant = match.id;
});

// Set default selection
if(colors.length) variantForm.querySelector('.color-box').click();


        modal.style.display = 'block';
      } catch(err) {
        console.error("Failed to load product:", err);
      }
    });
  });

  // Close modal
  modal.querySelector('.modal-close').addEventListener('click', () => modal.style.display = 'none');
  window.addEventListener('click', e => { if(e.target === modal) modal.style.display = 'none'; });

  // Add to cart
  document.getElementById('addToCartBtn').addEventListener('click', async function(e){
    e.preventDefault();
    const formData = new FormData(variantForm);
    const variantId = formData.get('variant_id');
    if(!variantId) return alert("Please select a variant!");

    try {
      await fetch('/cart/add.js', {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ quantity:1, id:variantId })
      });
      alert("Product added to cart!");
      modal.style.display = 'none';
    } catch(err) {
      console.error("Add to cart failed:", err);
    }
  });
});
</script>


