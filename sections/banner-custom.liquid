/* ----- MOBILE / SMALL ----- */
@media (max-width: 1023px) {
  .hamburger             { display:block; }
  .banner-tagline        { display:none;  }
  .primary-btn           { display:none;  }

  /* center the logo */
  .banner-logo {
    margin-left:auto;
    margin-right:auto;
    font-size:18px;
    font-weight:600;
  }

  /* use this version of heading+subtext */
  .banner-main.desktop-only { display:none; }

  .first-frame {
    position:relative;
    min-height:380px;
  }

  .first-frame::after{
    content:"SHOP NOW →";
    position:absolute;
    left:50%; bottom:25px;
    transform:translateX(-50%);
    background:#000; color:#fff;
    padding:12px 30px;
  }

  .banner-row        { flex-direction:column; margin-top:0; }
  .second-frame      { width:100%; min-height:350px; margin-top:20px; }
}

/* ----- DESKTOP ----- */
@media (min-width:1024px){
  .banner-main:not(.desktop-only){ display:none; }
  .banner-row   { display:flex; gap:40px; margin-top:40px; }
  .first-frame  { min-height:550px; }
  .second-frame { flex:1; min-height:500px; }
}
